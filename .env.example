# ConsensusAI — environment variables
# Copy this file to .env and fill in real values before deploying.

# --------------------------------------------------
# Server
# --------------------------------------------------

# Port the Express server listens on (default: 3001)
PORT=3001

# Path to the SQLite database file (default: packages/server/consensusai.sqlite)
# Use ':memory:' for tests (automatically set by vitest.config.ts)
DB_PATH=packages/server/consensusai.sqlite

# JWT signing secret — MUST be changed in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_change_in_production_jwt_secret_2026

# --------------------------------------------------
# Consensus Engine
# --------------------------------------------------

# Which engine to use: 'mock' (default) or 'ollama'
# 'ollama' requires a running Ollama server and falls back to mock on failure.
CONSENSUS_ENGINE=mock

# (Only used when CONSENSUS_ENGINE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
